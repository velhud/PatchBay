{
  "profile": {
    "id": "python-local",
    "backend": "trusted-local",
    "checks": [
      {
        "id": "unit",
        "argv": ["python", "-m", "pytest", "tests", "-q", "--junitxml=.author-reports/unit.xml"],
        "timeout_seconds": 3600,
        "report": "junit",
        "report_path": ".author-reports/unit.xml",
        "min_tests": 1,
        "allow_skipped": false
      }
    ],
    "cpu": 1.0,
    "memory_mb": 1024,
    "disk_mb": 2048,
    "log_bytes": 4194304
  },
  "writable_paths": ["**"],
  "blocked_paths": [".author-reports/**"],
  "auto_check": true,
  "allow_background_checks": true,
  "publication": {"enabled": false}
}
